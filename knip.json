{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "apps/client/src/main.ts",
        "apps/client/src/main.server.ts",
        "apps/client/src/server.ts",
        "apps/client/src/test-setup.ts",
        "testing/playwright/**/*.ts",
        "libs/*/src/index.ts"
    ],
    "project": ["apps/**/*.ts", "libs/*/src/**/*.ts", "testing/**/*.ts"],
    "ignoreDependencies": [
        "@angular/cli",
        "@angular/language-service",
        "@nx/workspace",
        "@swc/types",
        "ts-node",
        "@eslint/js",
        "angular-eslint",
        "typescript-eslint",
        "@typescript-eslint/utils",
        "jsonc-eslint-parser",
        "eslint-plugin-playwright",
        "codemirror",
        "@codemirror/lint",
        "@codemirror/search",
        "jest-environment-node",
        "jest-util",
        "ts-jest",
        "monocart-coverage-reports",
        "modern-normalize",
        "tslib"
    ]
}
