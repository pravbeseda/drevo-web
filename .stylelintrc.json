{
    "extends": "stylelint-config-standard-scss",
    "plugins": ["stylelint-declaration-strict-value"],
    "rules": {
        "scss/dollar-variable-pattern": [
            "^_?[a-z][a-z0-9]*(-([a-z0-9]+|A[0-9]+))*$",
            {
                "message": "Expected variable to be kebab-case (optional leading underscore, Material palette suffixes allowed)"
            }
        ],
        "selector-class-pattern": null,
        "keyframes-name-pattern": null,
        "font-family-no-missing-generic-family-keyword": null,
        "no-empty-source": null,
        "scss/comment-no-empty": null,
        "declaration-block-no-redundant-longhand-properties": [true, { "ignoreShorthands": ["grid-template"] }],
        "selector-pseudo-element-no-unknown": [true, { "ignorePseudoElements": ["ng-deep"] }],
        "scale-unlimited/declaration-strict-value": [
            ["/color$/", "fill", "stroke"],
            {
                "ignoreValues": [
                    "transparent",
                    "currentColor",
                    "currentcolor",
                    "inherit",
                    "initial",
                    "unset",
                    "none",
                    "/#\\{.+\\}/"
                ],
                "ignoreFunctions": false,
                "message": "Use a --themed-* color token instead of a hardcoded color"
            }
        ]
    },
    "overrides": [
        {
            "files": ["libs/ui/src/lib/styles/**/*.scss"],
            "rules": {
                "scale-unlimited/declaration-strict-value": null
            }
        },
        {
            "files": [
                "apps/client/src/app/layout/picture-lightbox/**/*.scss",
                "apps/client/src/app/features/picture/components/picture-card/**/*.scss"
            ],
            "rules": {
                "scale-unlimited/declaration-strict-value": null
            }
        }
    ]
}
