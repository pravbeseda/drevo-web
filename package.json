{
    "name": "@drevo-web/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "test": "nx run-many --target=test --all --parallel",
        "test:coverage": "nx run-many --target=test --all --parallel --coverage",
        "lint": "yarn nx affected -t lint --parallel",
        "format:check": "node ./node_modules/.bin/prettier . --check",
        "format:fix": "node ./node_modules/.bin/prettier . --write",
        "commitlint": "commitlint",
        "lint:playwright": "eslint --flag v10_config_lookup_from_file testing/playwright --max-warnings=0",
        "lint:styles": "stylelint \"{apps,libs}/**/*.scss\"",
        "lint:styles:fix": "stylelint \"{apps,libs}/**/*.scss\" --fix",
        "lint:types": "yarn lint:types:lib && yarn lint:types:spec",
        "lint:types:lib": "type-coverage -p libs/core/tsconfig.lib.json --at-least 99.90 && type-coverage -p libs/shared/tsconfig.lib.json --at-least 100 && type-coverage -p libs/ui/tsconfig.lib.json --at-least 99.94 && type-coverage -p libs/editor/tsconfig.lib.json --at-least 99.88",
        "lint:types:spec": "type-coverage -p libs/core/tsconfig.spec.json --at-least 99.95 && type-coverage -p libs/shared/tsconfig.spec.json --at-least 100 && type-coverage -p libs/ui/tsconfig.spec.json --at-least 99.95 && type-coverage -p libs/editor/tsconfig.spec.json --at-least 99.90",
        "lint:types:detail": "type-coverage -p libs/core/tsconfig.lib.json --detail; type-coverage -p libs/shared/tsconfig.lib.json --detail; type-coverage -p libs/ui/tsconfig.lib.json --detail; type-coverage -p libs/editor/tsconfig.lib.json --detail",
        "lint:typecheck": "tsc -p libs/shared/tsconfig.spec.json --noEmit && tsc -p libs/core/tsconfig.spec.json --noEmit && tsc -p libs/ui/tsconfig.spec.json --noEmit && tsc -p libs/editor/tsconfig.spec.json --noEmit && tsc -p apps/client/tsconfig.editor.json --noEmit && tsc -p apps/client/tsconfig.spec.json --noEmit && tsc -p apps/client-e2e/tsconfig.json --noEmit && tsc -p testing/playwright/tsconfig.json --noEmit",
        "lint:coverage": "node scripts/check-file-coverage.js",
        "test:scripts": "node --test \"scripts/*.test.js\"",
        "lint:workflows": "node scripts/check-release-workflow.js",
        "lint:ssr-hosts": "node scripts/check-ssr-hosts.js",
        "knip": "knip",
        "knip:deps": "knip --dependencies",
        "e2e": "yarn playwright test --config=apps/client-e2e/playwright.config.ts",
        "e2e:api": "yarn playwright test --project=api --config=apps/client-e2e/playwright.config.ts",
        "generate-version": "node scripts/generate-version.js",
        "build": "nx build client --configuration=production",
        "build:dev": "nx build client --configuration=development",
        "start": "node dist/apps/client/server/server.mjs",
        "serve": "nx serve client",
        "test:playwright": "playwright test --config=testing/playwright/playwright.config.ts --project=chromium",
        "test:playwright:coverage": "COVERAGE=true playwright test --config=testing/playwright/playwright.config.ts --project=chromium",
        "test:playwright:firefox": "playwright test --config=testing/playwright/playwright.config.ts --project=firefox",
        "test:playwright:webkit": "playwright test --config=testing/playwright/playwright.config.ts --project=webkit",
        "test:playwright:mobile": "playwright test --config=testing/playwright/playwright.config.ts --project=mobile-chrome --project=mobile-safari",
        "test:playwright:all": "playwright test --config=testing/playwright/playwright.config.ts",
        "test:playwright:ui": "playwright test --config=testing/playwright/playwright.config.ts --ui",
        "test:playwright:headed": "playwright test --config=testing/playwright/playwright.config.ts --headed",
        "prepare": "husky"
    },
    "private": true,
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    },
    "dependencies": {
        "@angular/animations": "22.1.2",
        "@angular/cdk": "22.1.2",
        "@angular/cdk-experimental": "22.1.2",
        "@angular/common": "22.1.2",
        "@angular/compiler": "22.1.2",
        "@angular/core": "22.1.2",
        "@angular/forms": "22.1.2",
        "@angular/material": "22.1.2",
        "@angular/platform-browser": "22.1.2",
        "@angular/platform-browser-dynamic": "22.1.2",
        "@angular/platform-server": "22.1.2",
        "@angular/router": "22.1.2",
        "@angular/ssr": "22.1.4",
        "@codemirror/autocomplete": "^6.20.0",
        "@codemirror/commands": "^6.10.1",
        "@codemirror/language": "^6.12.1",
        "@codemirror/lint": "^6.9.3",
        "@codemirror/merge": "^6.11.2",
        "@codemirror/search": "^6.6.0",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.7",
        "@sentry/angular": "^10.34.0",
        "dexie": "^4.2.1",
        "diff": "^9.0.0",
        "diff-match-patch": "^1.0.5",
        "express": "^4.21.2",
        "modern-normalize": "^3.0.1",
        "rxjs": "~7.8.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "22.1.4",
        "@angular-devkit/core": "22.1.4",
        "@angular-devkit/schematics": "22.1.4",
        "@angular/cli": "22.1.4",
        "@angular/compiler-cli": "22.1.2",
        "@angular/language-service": "22.1.2",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@ngneat/spectator": "^22.1.0",
        "@nx/angular": "23.1.1",
        "@nx/devkit": "23.1.1",
        "@nx/eslint": "23.1.1",
        "@nx/eslint-plugin": "23.1.1",
        "@nx/jest": "23.1.1",
        "@nx/js": "23.1.1",
        "@nx/playwright": "23.1.1",
        "@nx/web": "23.1.1",
        "@nx/workspace": "23.1.1",
        "@playwright/test": "^1.36.0",
        "@schematics/angular": "22.1.4",
        "@sentry/cli": "^3.1.0",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.15.47",
        "@swc/helpers": "0.5.23",
        "@types/diff-match-patch": "^1.0.36",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/node": "18.16.9",
        "angular-eslint": "22.1.0",
        "eslint": "^9.28.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-no-null": "^1.0.2",
        "eslint-plugin-playwright": "^1.6.2",
        "eslint-plugin-sonarjs": "^4.2.0",
        "husky": "^9.1.7",
        "jest": "^30.0.0",
        "jest-environment-jsdom": "^30.0.0",
        "jest-environment-node": "^30.0.0",
        "jest-preset-angular": "17.0.0",
        "js-yaml": "^5.2.3",
        "jsonc-eslint-parser": "^2.1.0",
        "knip": "^6.29.0",
        "lint-staged": "16",
        "monocart-reporter": "^2.10.0",
        "ng-mocks": "^14.15.0",
        "nx": "23.1.1",
        "prettier": "3.9.6",
        "serve": "^14.2.6",
        "stylelint": "^17.14.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-declaration-strict-value": "^1.11.1",
        "ts-jest": "29.4.12",
        "ts-node": "10.9.2",
        "tslib": "^2.3.0",
        "type-coverage": "^2.30.1",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.33.1",
        "wait-on": "^9.0.4",
        "zone.js": "0.16.2"
    },
    "//resolutions": {
        "eslint-plugin-sonarjs/typescript": "The plugin accepts >=5 <6.1.0 and would otherwise install its own TypeScript 6.x. Its type-aware rules must run on the same compiler as the build, or lint results silently diverge between CI, the editor's TS server and `yarn build`. Scoped to the plugin on purpose: an unscoped `typescript` pin would apply to Angular, typescript-eslint and jest too, and would then block the next TypeScript bump from somewhere unrelated to linting. Keep this in step with `devDependencies.typescript`."
    },
    "resolutions": {
        "eslint-plugin-sonarjs/typescript": "6.0.3"
    }
}
