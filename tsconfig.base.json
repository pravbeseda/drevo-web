{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "bundler",
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2015",
        "module": "esnext",
        "lib": ["es2022", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "paths": {
            "@angular/material/*": ["./node_modules/@angular/material/types/*.d.ts"],
            "@drevo-web/editor": ["./libs/editor/src/index.ts"],
            "@drevo-web/shared": ["./libs/shared/src/index.ts"],
            "@drevo-web/shared/diff": ["./libs/shared/src/lib/helpers/diff/index.ts"],
            "@drevo-web/shared/testing": ["./libs/shared/src/testing.ts"],
            "@drevo-web/ui/action-button": ["./libs/ui/src/lib/components/action-button/index.ts"],
            "@drevo-web/ui/avatar": ["./libs/ui/src/lib/components/avatar/index.ts"],
            "@drevo-web/ui/badge": ["./libs/ui/src/lib/components/badge/index.ts"],
            "@drevo-web/ui/banner": ["./libs/ui/src/lib/components/banner/index.ts"],
            "@drevo-web/ui/button": ["./libs/ui/src/lib/components/button/index.ts"],
            "@drevo-web/ui/button-toggle-group": ["./libs/ui/src/lib/components/button-toggle-group/index.ts"],
            "@drevo-web/ui/checkbox": ["./libs/ui/src/lib/components/checkbox/index.ts"],
            "@drevo-web/ui/confirmation": ["./libs/ui/src/lib/confirmation/index.ts"],
            "@drevo-web/ui/constants": ["./libs/ui/src/lib/constants/index.ts"],
            "@drevo-web/ui/dropdown-menu": ["./libs/ui/src/lib/components/dropdown-menu/index.ts"],
            "@drevo-web/ui/format-date": ["./libs/ui/src/lib/pipes/format-date/index.ts"],
            "@drevo-web/ui/format-time": ["./libs/ui/src/lib/pipes/format-time/index.ts"],
            "@drevo-web/ui/icon": ["./libs/ui/src/lib/components/icon/index.ts"],
            "@drevo-web/ui/icon-button": ["./libs/ui/src/lib/components/icon-button/index.ts"],
            "@drevo-web/ui/in-view": ["./libs/ui/src/lib/components/in-view/index.ts"],
            "@drevo-web/ui/inline-input": ["./libs/ui/src/lib/components/inline-input/index.ts"],
            "@drevo-web/ui/line-clamp": ["./libs/ui/src/lib/components/line-clamp/index.ts"],
            "@drevo-web/ui/modal": ["./libs/ui/src/lib/modal/index.ts"],
            "@drevo-web/ui/navigation-progress": ["./libs/ui/src/lib/components/navigation-progress/index.ts"],
            "@drevo-web/ui/providers": ["./libs/ui/src/lib/providers/index.ts"],
            "@drevo-web/ui/relative-time": ["./libs/ui/src/lib/pipes/relative-time/index.ts"],
            "@drevo-web/ui/resize-handle": ["./libs/ui/src/lib/components/resize-handle/index.ts"],
            "@drevo-web/ui/scrollbar": ["./libs/ui/src/lib/components/scrollbar/index.ts"],
            "@drevo-web/ui/short-date": ["./libs/ui/src/lib/pipes/short-date/index.ts"],
            "@drevo-web/ui/side-panel": ["./libs/ui/src/lib/components/side-panel/index.ts"],
            "@drevo-web/ui/spinner": ["./libs/ui/src/lib/components/spinner/index.ts"],
