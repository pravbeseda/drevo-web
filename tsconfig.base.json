            "@drevo-web/ui/text-input": ["./libs/ui/src/lib/components/text-input/index.ts"],
            "@drevo-web/ui/toggle": ["./libs/ui/src/lib/components/toggle/index.ts"],
            "@drevo-web/ui/tooltip": ["./libs/ui/src/lib/components/tooltip/index.ts"],
            "@drevo-web/ui/virtual-scroller": ["./libs/ui/src/lib/components/virtual-scroller/index.ts"],
            "@drevo-web/ui/workspace": ["./libs/ui/src/lib/components/workspace/index.ts"],
            "@drevo-web/core": ["./libs/core/src/index.ts"],
            "@drevo-web/core/testing": ["./libs/core/src/testing.ts"]
